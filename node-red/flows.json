    {
        "id": "68fe746047badf9f",
        "type": "function",
        "z": "462ff919a1215d8a",
        "name": "Router Suhu + Overheat Alert + Statistik",
        "func": "// Output 1 -> Line Chart 4 Garis & Bar Chart\n// Output 2 -> Toast Notification (jika suhu > 32.0 C)\n// Output 3 -> Panel Ringkasan Termal Gedung\nconst parts = msg.topic.split('/');\nconst roomName = parts[2]; // ruang1 .. ruang4\nconst tempVal = parseFloat(msg.payload);\nif (isNaN(tempVal)) return null;\n\nlet roomTemps = flow.get('roomTemps') || {};\nroomTemps[roomName] = tempVal;\nflow.set('roomTemps', roomTemps);\n\nconst keys = Object.keys(roomTemps);\nlet sum = 0, maxTemp = -999, hottestRoom = '-';\nfor (let k of keys) {\n    sum += roomTemps[k];\n    if (roomTemps[k] > maxTemp) {\n        maxTemp = roomTemps[k];\n        hottestRoom = k.toUpperCase();\n    }\n}\nconst avgTemp = (sum / keys.length).toFixed(1);\n\nconst msgChart = {\n    topic: roomName.toUpperCase(),\n    payload: tempVal\n};\n\nlet msgAlert = null;\nlet lastAlert = flow.get('lastAlert_' + roomName) || 0;\nconst now = Date.now();\nif (tempVal > 32.0 && (now - lastAlert > 15000)) {\n    flow.set('lastAlert_' + roomName, now);\n    msgAlert = {\n        topic: '⚠️ PERINGATAN SUHU TINGGI (' + roomName.toUpperCase() + ')',\n        payload: 'Suhu mencapai ' + tempVal.toFixed(1) + ' °C (Melewati batas aman 32.0 °C)!'\n    };\n}\n\nconst msgStats = {\n    payload: 'Rata-rata Gedung: ' + avgTemp + ' °C   |   Suhu Tertinggi: ' + maxTemp.toFixed(1) + ' °C (' + hottestRoom + ')'\n};\n\nreturn [msgChart, msgAlert, msgStats];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n// Memastikan urutan warna selalu RUANG1 (Biru), RUANG2 (Hijau), RUANG3 (Kuning), RUANG4 (Merah)\nsetTimeout(() => {\n    const rooms = [\"RUANG1\", \"RUANG2\", \"RUANG3\", \"RUANG4\"];\n    // Reset grafik terlebih dahulu lalu daftarkan urutannya\n    node.send([[{ payload: [] }], null, null]);\n    for (const r of rooms) {\n        node.send([[{ topic: r, payload: null }], null, null]);\n    }\n}, 500);",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 160,
