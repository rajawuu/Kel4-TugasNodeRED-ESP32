        "head": "",
        "format": "/* Background utama gelap bergaya Command Center */\n.v-main {\n    background: radial-gradient(circle at top, #0f172a 0%, #090d16 100%) !important;\n    color: #f8fafc !important;\n}\n\n/* Tampilan kartu tiap Group Ruangan */\n.nrdb-ui-group .v-card {\n    background: linear-gradient(145deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95)) !important;\n    border: 1px solid rgba(56, 189, 248, 0.35) !important;\n    border-radius: 16px !important;\n    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5) !important;\n    padding: 6px !important;\n    color: #f8fafc !important;\n}\n\n/* Judul Group Ruangan (Ruang 1 - 4 & Analitik) */\n.nrdb-ui-group .v-card-title {\n    color: #38bdf8 !important;\n    font-size: 1.05rem !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.8px !important;\n    text-transform: uppercase !important;\n    border-bottom: 1px solid rgba(56, 189, 248, 0.25) !important;\n    padding-bottom: 10px !important;\n    margin-bottom: 10px !important;\n}\n\n/* Header Bar Atas */\n.v-app-bar {\n    background: linear-gradient(90deg, #0f172a 0%, #1e3a8a 100%) !important;\n    border-bottom: 1px solid rgba(56, 189, 248, 0.45) !important;\n    color: #ffffff !important;\n}\n.v-app-bar-title {\n    color: #f8fafc !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.5px !important;\n}\n\n/* Perjelas teks label pada Text & Switch */\n.nrdb-ui-text, .nrdb-ui-switch {\n    background: rgba(15, 23, 42, 0.65) !important;\n    border: 1px solid rgba(148, 163, 184, 0.18) !important;\n    border-radius: 10px !important;\n    padding: 8px 14px !important;\n}\n.nrdb-ui-switch:hover {\n    border-color: rgba(56, 189, 248, 0.6) !important;\n    background: rgba(30, 41, 59, 0.9) !important;\n    cursor: pointer !important;\n}\n.nrdb-ui-text-label, .nrdb-ui-switch label, .v-label {\n    color: #e2e8f0 !important;\n    font-weight: 600 !important;\n    font-size: 0.95rem !important;\n    opacity: 1 !important;\n}\n.nrdb-ui-text-value {\n    color: #38bdf8 !important;\n    font-weight: 800 !important;\n    font-size: 1.05rem !important;\n}\n\n/* Gauge teks & angka tengah lebih besar dan terang */\n.nrdb-ui-gauge text {\n    fill: #f8fafc !important;\n    font-weight: 700 !important;\n}\n",
