        "name": "Router & Badge Status (Ruang 1 - 4)",
        "func": "// Mengubah 'online'/'offline' menjadi Badge Visual & merutekan ke Ruang 1-4\nconst parts = msg.topic.split('/');\nconst room = parts[2];\nconst raw = String(msg.payload).trim().toLowerCase();\nconst badge = (raw === 'online') ? '🟢 ONLINE (Tersambung)' : '🔴 OFFLINE (Terputus)';\nconst out = { payload: badge };\n\nif (room === 'ruang1') return [out, null, null, null];\nif (room === 'ruang2') return [null, out, null, null];\nif (room === 'ruang3') return [null, null, out, null];\nif (room === 'ruang4') return [null, null, null, out];\nreturn null;",
