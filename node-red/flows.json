        "id": "41c437ac050feecc",
        "type": "function",
        "z": "462ff919a1215d8a",
        "name": "Router Kelembapan (Ruang 1 - 4)",
        "func": "// Memecah pens/klp4/<ruang>/humidity ke 4 output Gauge secara otomatis\nconst parts = msg.topic.split('/');\nconst room = parts[2];\nconst val = parseFloat(msg.payload);\nif (isNaN(val)) return null;\n\nconst out = { payload: val };\nif (room === 'ruang1') return [out, null, null, null];\nif (room === 'ruang2') return [null, out, null, null];\nif (room === 'ruang3') return [null, null, out, null];\nif (room === 'ruang4') return [null, null, null, out];\nreturn null;",
